{
  "name": "@sp-insulina/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch index.ts",
    "start": "node --env-file-if-exists=.env index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:import": "node --env-file-if-exists=.env scripts/d1-to-postgres.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@hono/otel": "^1.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.13.22",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}

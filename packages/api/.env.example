DATABASE_URL=postgres://postgres:postgres@localhost:5432/sp_insulinas
PORT=3000

# Versão publicada da imagem; vai para service.version e /health.
SERVICE_VERSION=0.0.0-dev
DEPLOYMENT_ENVIRONMENT=development

# Telemetria: só liga com um endpoint OTLP/HTTP definido (porta 4318 do collector).
# Ex.: http://localhost:4318 — o SDK acrescenta /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers no formato chave=valor,chave2=valor2 (ex.: authorization=Bearer token).
OTEL_EXPORTER_OTLP_HEADERS=
# always_on | always_off | traceidratio | parentbased_always_on |
# parentbased_always_off | parentbased_traceidratio
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
